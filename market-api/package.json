{
  "name": "nf-market-api",
  "version": "1.0.0",
  "private": true,
  "description": "NF Client 插件市场 API（Cloudflare Workers）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.0.0"
  }
}
